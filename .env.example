# ==============================================================================
# Enterprise Selenium Python Automation & QA Dashboard Environment Variables
# ==============================================================================
# Copy this file to .env or .env.local for local overrides.
# NOTE: Never commit .env or files containing plain secrets to version control.
# All values below are PLACEHOLDERS - replace with your actual values or
# set corresponding environment variables before running tests.

# --- Database Storage (Optional - for Neon / Supabase PostgreSQL) ---
# When omitted, the platform defaults to high-performance JSON file storage.
DATABASE_URL=postgresql://postgres:password_placeholder@db.example.com/telemetry?sslmode=require

# --- Dashboard Authentication & Telemetry Ingestion API ---
# These are optional; leave commented out or set real values for production DASHBOARD
# DASHBOARD_ADMIN_USER=admin
# DASHBOARD_ADMIN_PASSWORD=change_me
# AUTH_SECRET=change_this_to_a_secure_random_key
# DASHBOARD_API_KEY=change_me

# --- Automation Engine & Selenium WebDriver (Local / CI / Docker) ---
# Base URL for the application under test
BASE_URL=https://www.saucedemo.com
# Target browser: chrome, firefox, edge, or browserstack
BROWSER=chrome
# Run browser in headless mode (no UI)
HEADLESS=true
# Environment: qa, staging, or production
ENV=qa

# --- Cloud Grid Automation (BrowserStack) ---
# Set BROWSERSTACK_USERNAME and BROWSERSTACK_ACCESS_KEY as environment variables
# or uncomment and fill in the values below (not recommended for source control):
# BROWSERSTACK_USERNAME=your_browserstack_username
# BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# --- Email Reporting & Notifications (Optional) ---
# SMTP host for email report delivery (optional)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password

# --- CI/CD Runner Metadata ---
CI_SYSTEM=Local Run
